{
	"name": "jazzsequence/www",
	"description": "Main jazzsequence network",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "wpackagist-plugin/wp-syntax",
				"version": "1.2",
				"type": "wordpress-plugin",
				"dist": {
					"url": "https://downloads.wordpress.org/plugin/wp-syntax.1.2.zip",
					"type": "zip"
				},
				"require": {
					"composer/installers": "~1.0"
				}
			}
		},
		{
			"type": "vcs",
			"url": "git@github.com:jazzsequence/jz-222.git"
		},
		{
			"type": "vcs",
			"url": "git@github.com:jazzsequence/altis-cms.git"
		},        
		{
			"type": "composer",
			"url": "https://repo.wp-packages.org"
		},
		{
			"type": "composer",
			"url": "https://packages.jazzsequence.com"
		},
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"altis/browser-security": "*",
		"altis/cms": "*",
		"altis/workflow": "*",
		"cmb2/cmb2": "*",
		"humanmade/amf-unsplash": "*",
		"humanmade/gaussholder": "*",
		"humanmade/hm-redirects": "*",
		"humanmade/meta-tags": "*",
		"humanmade/orphan-command": "*",
		"humanmade/two-factor": "*",
		"humanmade/wordpress-importer": "dev-master",
		"humanmade/wp-seo": "*",
		"jazzsequence/address-book": "*",
		"jazzsequence/dashboard-changelog": "*",
		"jazzsequence/games-collector": "^2.0",
		"jazzsequence/jz-222": "dev-main",
		"jazzsequence/recipe-box": "*",
		"johnbillion/extended-cpts": "*",
		"pfefferle/wordpress-activitypub": "*",
		"wordpress/mcp-adapter": "*",
		"wp-plugin/akismet": "*",
		"wp-plugin/altis-accelerate": "*",
		"wp-plugin/amazon-s3-and-cloudfront": "*",
		"wp-plugin/autoblue": "*",
		"wp-plugin/bv-pantheon-migration": "*",
		"wp-plugin/glotpress": "*",
		"wp-plugin/gutenberg": "*",
		"wp-plugin/hello-ziggy": "*",
		"wp-plugin/litespeed-cache": "*",
		"wp-plugin/ninja-forms": "*",
		"wp-plugin/organize-series": "*",
		"wp-plugin/pantheon-content-publisher": "*",
		"wp-plugin/patchstack": "*",
		"yoast/duplicate-post": "4.6 as 4.1.3",
		"wp-plugin/plugins-garbage-collector": "*",
		"wp-plugin/progress-bar": "*",
		"wp-plugin/query-monitor": "*",
		"wp-plugin/regenerate-thumbnails": "*",
		"wp-plugin/storyftw": "*",
		"wp-plugin/support-webp": "*",
		"wp-plugin/term-management-tools": "*",
		"wp-plugin/wp-crontrol": "*",
		"wp-plugin/wp-mail-smtp": "*",
		"wpackagist-plugin/wp-syntax": "1.2",
		"wp-theme/museum-core": "*",
		"wp-theme/ryu": "*",
		"wp-theme/twentynineteen": "*",
		"wp-theme/twentyseventeen": "*",
		"wp-theme/twentytwenty": "*",
		"wp-theme/twentytwentyfive": "*",
		"wp-theme/twentytwentyone": "*",
		"wp-theme/twentytwentythree": "*",
		"wp-theme/twentytwentytwo": "*"
	},
	"replace":{
		"johnpbloch/wordpress": "*"
	},
	"extra": {
		"installer-paths": {
			"wp-content/mu-plugins/{$name}": [
				"type:wordpress-muplugin",
				"jazzsequence/dashboard-changelog",
				"cmb2/cmb2"
			],
			"wp-content/plugins/{$name}": ["type:wordpress-plugin"],
			"wp-content/themes/{$name}": ["type:wordpress-theme"]
		}
	},
	"require-dev": {
		"johnbillion/query-monitor": "*",
		"johnbillion/wp-crontrol": "^1.16",
		"pantheon-systems/pantheon-wp-coding-standards": "^3.0",
		"phpunit/phpunit": "^9.5",
		"yoast/phpunit-polyfills": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"altis/cms-installer": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"johnpbloch/wordpress-core-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	},
	"scripts": {
		"backup-files": [
			"if [ -f wp-config.php ]; then cp wp-config.php wp-config.php.bak; fi",
			"if [ -f index.php ]; then cp index.php index.php.bak; fi"
		],
		"restore-backup-files": [
			"if [ -f wp-config.php.bak ]; then mv wp-config.php.bak wp-config.php; fi",
			"if [ -f index.php.bak ]; then mv index.php.bak index.php; fi",
			"rm .build-script"
		],
		"pre-update-cmd": [
			"@backup-files"
		],
		"post-update-cmd": [
			"@restore-backup-files"
		],
		"pre-install-cmd": "@backup-files",
		"post-install-cmd": "@restore-backup-files",
		"shellcheck": [
			"shellcheck bin/*.sh"
		],
		"phpcs": "vendor/bin/phpcs -s .",
		"phpcbf": "vendor/bin/phpcbf .",
		"dry-run-release": "bash bin/dry-run-release.sh"
	}
}
